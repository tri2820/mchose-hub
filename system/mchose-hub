#!/usr/bin/env bash
set -e

PORT=18989
WEB_DIR="$HOME/.local/share/mchose-web"

# Ensure temporary permissions on MCHOSE hidraw nodes if needed
for dev in /sys/class/hidraw/hidraw*; do
  if [ -f "$dev/device/uevent" ] && grep -q "000041E4:00002120" "$dev/device/uevent"; then
    node="/dev/$(basename "$dev")"
    if [ ! -w "$node" ]; then
      sudo chmod 666 "$node" 2>/dev/null || true
    fi
  fi
done

# Start local server if not running
if ! curl -s -m 1 "http://127.0.0.1:$PORT/" >/dev/null 2>&1; then
  python3 -m http.server "$PORT" --directory "$WEB_DIR" --bind 127.0.0.1 >/dev/null 2>&1 &
  sleep 0.5
fi

# Launch in Chrome app mode
exec google-chrome --app="http://127.0.0.1:$PORT/#/home" "$@"
